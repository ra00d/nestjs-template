{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "rspack",
    "manualRestart": true,
    "deleteOutDir": true,
    "plugins": ["@nestjs/swagger"],
    "assets": [
      { "include": "mail/templates/**/*" },
      { "include": "i18n/**/*" },
      { "include": "../storage/**/*", "outDir": "dist/stg" }
    ]
  }
}
