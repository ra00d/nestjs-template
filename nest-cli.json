{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "rspack",
    "manualRestart": true,
    "deleteOutDir": true,
    "plugins": ["@nestjs/swagger"],
    "assets": [
      { "include": "mail/templates/**/*", "watchAssets": true },
      { "include": "i18n/**/*", "watchAssets": true },
      {
        "include": "../storage/**/*",
        "watchAssets": true,
        "outDir": "dist/stg"
      }
    ]
  }
}
