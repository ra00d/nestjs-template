# Server
NODE_ENV=development
PORT=3000

# PostgreSQL (the Drizzle connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs_template

# Access tokens. At least 32 characters; change it to invalidate every token issued before.
JWT_SECRET=please-change-me-to-a-random-32-character-string

# Where the verification, reset and sign-in links point, and the tokens' issuer/audience.
# Without a base a relative URL is used, for the command line or local tests.
APP_URL=http://localhost:3000

# Extra pages allowed to send the API cross-origin writes (comma-separated).
# For a dedicated frontend, for example: https://app.example.com
TRUSTED_ORIGINS=

# Email. Leave SMTP_URL empty to print messages into the log instead of sending them.
SMTP_URL=
MAIL_FROM=Store <no-reply@example.com>