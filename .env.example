# Server
NODE_ENV=development
PORT=3000
# URL prefix for all versioned API routes (Swagger stays at `/docs`).
API_PREFIX=api

# PostgreSQL (the Drizzle connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs_template
# Run Drizzle SQL migrations on boot when `true`. Prefer `pnpm db:migrate` in production.
DB_MIGRATE_ON_BOOT=false

# Access tokens. At least 32 characters; change it to invalidate every token issued before.
JWT_SECRET=please-change-me-to-a-random-32-character-string

# Secure-session cookie secret (at least 32 chars) and salt (at least 8 chars).
# Generate with: pnpm dlx --yes openssl rand -base64 32
SESSION_SECRET=please-change-me-to-a-random-32-character-string
SESSION_SALT=please-change-me

# Where the verification, reset and sign-in links point, and the tokens' issuer/audience.
# Without a base a relative URL is used, for the command line or local tests.
APP_URL=http://localhost:3000

# Extra pages allowed to send the API cross-origin writes (comma-separated).
# For a dedicated frontend, for example: https://app.example.com
TRUSTED_ORIGINS=

# Email. Leave SMTP_URL empty to print messages into the log instead of sending them.
SMTP_URL=
MAIL_FROM=Store <no-reply@example.com>

# Localization. The locale used when the request names none (via `?lang=`,
# the `x-lang` header, the `lang` cookie or `Accept-Language`) and outside
# requests. Must have a catalog in `src/i18n`.
DEFAULT_LOCALE=en

# Redis (the Keyv store behind `CacheService`) and the cache defaults.
REDIS_URL=redis://localhost:6379
# Prefixes every key as `<namespace>::<key>`; unset shares one keyspace.
REDIS_NAMESPACE=
# Default cache TTL in milliseconds; unset, and entries live until overwritten.
CACHE_DEFAULT_TTL=